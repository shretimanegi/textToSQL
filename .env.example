# Postgres (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=texttosql
POSTGRES_PORT=5436
READONLY_PASSWORD=change-me-readonly

# Backend connection URLs (localhost when running outside compose)
ADMIN_DATABASE_URL=postgresql://postgres:change-me-admin@localhost:5436/texttosql
READONLY_DATABASE_URL=postgresql://readonly_user:change-me-readonly@localhost:5436/texttosql

# LLM (provider: gemini | anthropic | openai)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EVAL_DATABASE_URL=postgresql://eval_readonly:change-me-readonly@localhost:5436/texttosql
NEXT_PUBLIC_API_URL=http://localhost:8010

# Frontend origin(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:3010
# Questions per client IP per hour on /ask
RATE_LIMIT_PER_HOUR=20
# mock = canned answers for local UI testing without an LLM key (set LLM_PROVIDER=mock)

# Reverse proxies in front of the API (Render: 1). 0 locally.
TRUSTED_PROXY_HOPS=0
